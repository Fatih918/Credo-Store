# Credo Store — local Supabase configuration
# Copy this file to .env.local and replace the placeholders with values
# from Supabase Dashboard > Project Settings > API.
#
# These variables are intended for the upcoming Supabase application integration.
# Do not put secret/service-role keys in NEXT_PUBLIC variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
